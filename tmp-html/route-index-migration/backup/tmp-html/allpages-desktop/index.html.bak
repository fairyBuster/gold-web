<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>E2E all-pages desktop audit</title>
<style>
  body { margin: 0; font-family: Consolas, monospace; background: #101010; color: #d0d0d0; }
  #results { white-space: pre-wrap; font-size: 12px; line-height: 1.35; padding: 12px; }
  iframe { width: 0; height: 0; border: 0; visibility: hidden; position: absolute; }
</style>
</head>
<body>
<pre id="results">booting…</pre>
<script>
/* ============================================================================
   All-pages desktop audit.
   Pass 1: every route in a 1440px-wide iframe — verifies the centered app
   column (max-width 480px), full-bleed backgrounds (no capped element paints
   an opaque full-height background), no desktop drop shadows on the column,
   bottom-nav centering, and horizontal overflow.
   Pass 2: mobile spot check at 390px — verifies nothing is capped there
   (mobile layout must stay unchanged).
   ============================================================================ */

const ROUTES = [
  '/sitemap',
  '/auth/welcome',
  '/auth/popup-awal',
  '/auth/notifikasi-login',
  '/auth/login',
  '/auth/register-01',
  '/auth/register-02',
  '/auth/register-03',
  '/auth/register-04',
  '/auth/lupa-password',
  '/auth/lupa-password-02',
  '/auth/lupa-password-03',
  '/auth/lupa-password-04',
  '/home',
  '/assets/alamat-pengiriman',
  '/assets/aset-03',
  '/assets/aset-saya-01',
  '/assets/aset-saya-02',
  '/assets/asset-01',
  '/assets/asset-02',
  '/assets/cetak-emas-01',
  '/assets/cetak-emas-02',
  '/assets/cetak-emas-03',
  '/assets/emas-digital',
  '/assets/konfirmasi',
  '/profil/beri-rating',
  '/profil/beri-rating-02',
  '/transactions/detail-penarikan',
  '/transactions/detail-penarikan-02',
  '/transactions/detail-penarikan-03',
  '/rewards/detail-riwayat-poin',
  '/transactions/isi-ulang',
  '/transactions/loading-penarikan',
  '/profil/pilih-bank',
  '/transactions/qris',
  '/assets/riwayat-aset-saya',
  '/affiliate/riwayat-detail-komisi',
  '/transactions/riwayat-isi-ulang',
  '/affiliate/riwayat-komisi',
  '/rewards/riwayat-lainnya',
  '/transactions/riwayat-penarikan',
  '/rewards/riwayat-poin',
  '/transactions/riwayat-transaksi',
  '/transactions/tarik-dana-01',
  '/transactions/tarik-dana-02',
  '/transactions/tarik-dana-03',
  '/transactions/tarik-dana-04',
  '/transactions/virtual-account',
  '/rewards/absen-harian',
  '/rewards/misi',
  '/rewards/poin-mall-01',
  '/rewards/poin-mall-02',
  '/rewards/poin-mall-03',
  '/rewards/redeem-kode',
  '/rewards/vip',
  '/rewards/vip-redeem-kode',
  '/profil/edit',
  '/profil/kartu-bank',
  '/profil/kartu-bank-02',
  '/profil/kartu-bank-03',
  '/profil/notifikasi',
  '/profil',
  '/profil/setelan',
  '/affiliate/detail-tim',
  '/affiliate/tim-afiliasi',
  '/berita',
  '/berita/detail',
  '/support/hubungi-cs',
  '/support/kebijakan-privasi',
  '/support/livechat',
  '/support/pertanyaan-umum',
  '/support/syarat-dan-ketentuan',
  '/support/tentang-kami',
  '/landing',
];

const MOBILE_ROUTES = [
  '/auth/login',
  '/auth/register-01',
  '/auth/register-02',
  '/auth/register-03',
  '/auth/register-04',
  '/auth/welcome',
  '/auth/notifikasi-login',
  '/home',
  '/rewards/poin-mall-01',
  '/rewards/riwayat-poin',
  '/profil/pilih-bank',
  '/assets/cetak-emas-01',
  '/profil/kartu-bank',
  '/rewards/vip',
];

const CLEAR = 'rgba(0, 0, 0, 0)';

function nameOf(el) {
  const cls = String(el.className || '').split(' ').filter(Boolean).slice(0, 2).join('.');
  return el.tagName.toLowerCase() + (el.id ? '#' + el.id : '') + (cls ? '.' + cls : '');
}

function measure(frame, route, mode) {
  const doc = frame.contentDocument;
  const win = frame.contentWindow;
  const out = { route: route, flags: [] };
  try {
    const docEl = doc.documentElement;
    const clientW = docEl.clientWidth;
    const clientH = docEl.clientHeight;
    out.hOver = docEl.scrollWidth - clientW;

    const root = doc.querySelector('#root > [class^="page-"]');
    if (!root) {
      out.root = null;
      out.flags.push('NO-PAGE-ROOT');
      return out;
    }
    out.root = root.className;
    const isLanding = root.className.indexOf('landing') !== -1;

    const kids = [].slice.call(root.children).filter(function (el) {
      return el.tagName === 'DIV' || el.tagName === 'MAIN' || el.tagName === 'SECTION';
    });
    out.kids = kids.length;

    let capped = 0;
    let centered = 0;
    kids.forEach(function (el) {
      const r = el.getBoundingClientRect();
      const cs = win.getComputedStyle(el);
      const id = nameOf(el);
      const cap = cs.maxWidth;

      if (mode === 'mobile') {
        if (cap === '480px') out.flags.push('MOBILE-CAPPED ' + id);
        return;
      }

      if (isLanding) return; /* landing has its own layout — checked in Task A */

      if (cap !== '480px') {
        if (r.width > 520) out.flags.push('NOT-CAPPED ' + id + ' w=' + Math.round(r.width) + ' maxW=' + cap);
        return;
      }
      capped++;
      const expected = (clientW - r.width) / 2;
      if (Math.abs(r.left - expected) <= 2) {
        centered++;
      } else {
        out.flags.push('OFF-CENTER ' + id + ' left=' + Math.round(r.left) + ' exp=' + Math.round(expected));
      }
      if (cs.boxShadow !== 'none') out.flags.push('SHADOW-ON-CAP ' + id);
      const bgOn = cs.backgroundColor !== CLEAR || cs.backgroundImage !== 'none';
      if (bgOn && r.height > clientH * 0.8) out.flags.push('FULLBG-ON-CAP ' + id + ' h=' + Math.round(r.height));

      /* Depth-2: inner full-page containers that create frame artifacts. */
      [].slice.call(el.children).slice(0, 14).forEach(function (sub) {
        const r2 = sub.getBoundingClientRect();
        const cs2 = win.getComputedStyle(sub);
        if (cs2.position === 'fixed') return;
        const id2 = nameOf(sub);
        const bg2 = cs2.backgroundColor !== CLEAR || cs2.backgroundImage !== 'none';
        if (r2.height > clientH * 0.8 && bg2) out.flags.push('D2-FULLBG ' + id2 + ' h=' + Math.round(r2.height));
        if (r2.height > clientH * 0.6 && cs2.boxShadow !== 'none') out.flags.push('D2-SHADOW ' + id2 + ' h=' + Math.round(r2.height));

        /* Depth-3: same check one level deeper (container inside a section).
           Opaque-only: translucent decoration gradients never create frame
           edges, so they are not flagged. */
        [].slice.call(sub.children).slice(0, 14).forEach(function (sub2) {
          const cs3 = win.getComputedStyle(sub2);
          if (cs3.position === 'fixed') return;
          const r3 = sub2.getBoundingClientRect();
          const id3 = nameOf(sub2);
          const bg3 = cs3.backgroundColor !== CLEAR || /\brgb\(/.test(cs3.backgroundImage);
          if (r3.height > clientH * 0.8 && bg3) out.flags.push('D3-FULLBG ' + id3 + ' h=' + Math.round(r3.height));
          if (r3.height > clientH * 0.6 && cs3.boxShadow !== 'none') out.flags.push('D3-SHADOW ' + id3 + ' h=' + Math.round(r3.height));
        });
      });
    });
    out.cap = capped + '/' + kids.length + ' centered:' + centered;

    const nav = doc.querySelector('.bottom-nav');
    if (nav) {
      const nr = nav.getBoundingClientRect();
      const ncs = win.getComputedStyle(nav);
      out.nav = Math.round(nr.width) + 'px@' + Math.round(nr.left) + ' max:' + ncs.maxWidth;
      if (ncs.maxWidth !== '480px') out.flags.push('NAV-NOT-CAPPED');
    }
  } catch (e) {
    out.flags.push('ERR ' + e.message);
  }
  if (!out.flags.length) delete out.flags;
  return out;
}

function loadRoute(frame, route, settleMs) {
  return new Promise(function (resolve) {
    let done = false;
    const finish = function () {
      if (done) return;
      done = true;
      setTimeout(resolve, settleMs);
    };
    frame.onload = finish;
    frame.src = route;
    setTimeout(finish, 7000); /* safety cap */
  });
}

async function audit(width, routes, mode) {
  const results = [];
  for (let i = 0; i < routes.length; i++) {
    const frame = document.createElement('iframe');
    frame.style.width = width + 'px';
    frame.style.height = '900px';
    document.body.appendChild(frame);
    await loadRoute(frame, routes[i], 1200);
    results.push(measure(frame, routes[i], mode));
    frame.src = 'about:blank';
    await new Promise(function (r) { setTimeout(r, 60); });
    frame.remove();
  }
  return results;
}

async function getToken() {
  try {
    const res = await fetch('/e2e-token.json', { cache: 'no-store' });
    if (!res.ok) return null;
    return await res.json();
  } catch (e) {
    return null;
  }
}

(async function () {
  const pre = document.getElementById('results');
  const lines = [];

  const tok = await getToken();
  if (tok && tok.access) {
    localStorage.setItem('je_auth_session', JSON.stringify({ access: tok.access, refresh: tok.refresh || '' }));
    lines.push('TOKEN: injected (user=' + (tok.user || '?') + ')');
  } else {
    pre.textContent = 'NO TOKEN FILE (/e2e-token.json missing or unreadable)';
    document.title = 'E2E-NO-TOKEN';
    return;
  }

  lines.push('== DESKTOP 1440 ==');
  const desktop = await audit(1440, ROUTES, 'desktop');
  desktop.forEach(function (r) { lines.push(JSON.stringify(r)); });

  lines.push('== MOBILE 390 ==');
  const mobile = await audit(390, MOBILE_ROUTES, 'mobile');
  mobile.forEach(function (r) { lines.push(JSON.stringify(r)); });

  const flagged = desktop.filter(function (r) { return r.flags; }).length;
  const flaggedM = mobile.filter(function (r) { return r.flags; }).length;
  lines.push('== SUMMARY ==');
  lines.push('desktop flagged: ' + flagged + '/' + desktop.length + ' | mobile flagged: ' + flaggedM + '/' + mobile.length);

  pre.textContent = lines.join('\n');
  document.title = 'E2E-DONE';
})();
</script>
</body>
</html>
