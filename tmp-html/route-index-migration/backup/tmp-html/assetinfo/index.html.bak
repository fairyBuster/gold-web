<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ASSET-INFO-RUNNING</title>
</head>
<body>
  <div id="root"></div>
  <pre id="info-metrics">pending</pre>
  <script type="module">
    /* E2E probe for the Asset-02 "Informasi Produk" table: the section must
       render one row per filled custom_field_N pair, labelled "Periode 1..N"
       in Keterangan (title → Penjelasan, content → Detail), and disappear
       entirely when no field is filled. ?pid=<id> picks the fixture product. */
    const metrics = { errors: [], pid: null };
    window.addEventListener('error', (e) => metrics.errors.push(String(e.message)));
    window.addEventListener('unhandledrejection', (e) => metrics.errors.push(String(e.reason)));

    const paramPid = Number(new URLSearchParams(location.search).get('pid')) || 134;
    metrics.pid = paramPid;

    const BASE = {
      golongan: 'Simpanan',
      description: '-',
      price: '50000.00',
      status: 1,
      stock: 4999,
      stock_enabled: true,
      profit_type: 'random',
      profit_rate: '0.00',
      profit_random_min: '6250.00',
      profit_random_max: '10350.00',
      profit_method: 'hold',
      duration: 40,
      balance_source: 'balance_deposit',
      claim_reset_mode: 'after_purchase',
      claim_reset_hours: 0,
    };
    const emptyFields = Object.fromEntries(
      Array.from({ length: 10 }, (_, i) => [`custom_field_${i + 1}_title`, null])
        .concat(Array.from({ length: 10 }, (_, i) => [`custom_field_${i + 1}_content`, '']))
    );
    const fixtures = {
      /* Mirrors the reported product JSON: slots 1-3 filled, slot 4 null and
         slot 5 a "-" placeholder — the last two must both be dropped. */
      134: {
        ...BASE,
        id: 134,
        name: 'Logam 24K',
        ...emptyFields,
        custom_field_1_title: 'Field 01',
        custom_field_1_content: 'Field content 01',
        custom_field_2_title: 'Field 02',
        custom_field_2_content: 'Field content 02',
        custom_field_3_title: 'Field 03',
        custom_field_3_content: 'Field content 03',
        custom_field_5_title: 'Field 05',
        custom_field_5_content: '-',
      },
      200: {
        ...BASE,
        id: 200,
        name: 'Rencana Tanpa Field',
        ...emptyFields,
      },
    };

    const json = (data, status = 200) => new Response(JSON.stringify(data), {
      status,
      headers: { 'Content-Type': 'application/json' },
    });
    window.fetch = (url) => {
      const target = String(url);
      if (target.includes(`/api/products/${paramPid}/`)) return Promise.resolve(json(fixtures[paramPid]));
      if (target.includes('/api/products/')) return Promise.resolve(json({ count: 1, results: [fixtures[paramPid]] }));
      return Promise.resolve(json({}, 404));
    };

    window.localStorage.setItem('je_auth_session', JSON.stringify({ access: 'e2e-token' }));
    window.sessionStorage.setItem('je_asset_product_id', String(paramPid));

    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    const writeMetrics = (passed) => {
      metrics.allPassed = passed;
      document.getElementById('info-metrics').textContent = JSON.stringify(metrics, null, 2);
      document.title = 'ASSET-INFO-DONE';
    };
    const waitFor = async (selector, timeout = 6000) => {
      const start = performance.now();
      while (performance.now() - start < timeout) {
        const el = document.querySelector(selector);
        if (el) return el;
        await sleep(50);
      }
      return null;
    };

    history.replaceState(null, '', '/assets/asset-02');
    await import('/src/main.jsx');

    await waitFor('.page-asset-02 .card');
    const section = document.querySelector('.page-asset-02 #product-info');
    metrics.hasSection = !!section;
    metrics.pageText = document.querySelector('.page-asset-02')?.textContent ?? '';
    if (section) {
      metrics.title = section.querySelector('.section-title')?.textContent.trim() ?? null;
      metrics.headers = [...section.querySelectorAll('.table-header .col')].map((el) => el.textContent.trim());
      metrics.rows = [...section.querySelectorAll('.table-row')].map((row) => ({
        left: row.querySelector('.col.left')?.textContent.trim() ?? null,
        center: row.querySelector('.col.center')?.textContent.trim() ?? null,
        hasRight: !!row.querySelector('.col.right'),
        right: row.querySelector('.col.right')?.textContent.trim() ?? null,
      }));
      metrics.tableText = section.querySelector('.table-container')?.textContent ?? '';
    }

    let passed;
    if (paramPid === 134) {
      const r = metrics.rows ?? [];
      passed = metrics.hasSection
        && metrics.title === 'Informasi Produk'
        && JSON.stringify(metrics.headers) === JSON.stringify(['Keterangan', 'Penjelasan', 'Detail'])
        && r.length === 3
        && r[0].left === 'Periode 1' && r[0].center === 'Field 01' && r[0].right === 'Field content 01'
        && r[1].left === 'Periode 2' && r[1].center === 'Field 02' && r[1].right === 'Field content 02'
        && r[2].left === 'Periode 3' && r[2].center === 'Field 03' && r[2].right === 'Field content 03'
        && !metrics.tableText.includes('Rp')
        && !metrics.pageText.includes('Simulasi Perhitungan')
        && !metrics.pageText.includes('Field 05')
        && metrics.errors.length === 0;
    } else {
      passed = !metrics.hasSection
        && !metrics.pageText.includes('Informasi Produk')
        && metrics.errors.length === 0;
    }
    writeMetrics(passed);
  </script>
</body>
</html>
